{
  "name": "verbs-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces",
    "build-verb": "npm run build --workspace=verbs-cli",
    "build-prompt": "npm run build --workspace=@amirab/prompt",
    "test": "npm run test --workspaces",
    "test-prompt": "npm run test --workspace=@amirab/prompt",
    "test-verb": "npm run test --workspace=verbs-cli",
    "verb": "npm run build-verb && node packages/verbs-cli/dist/cli.js",
    "prompt": "npm run build-prompt && node packages/prompt/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
